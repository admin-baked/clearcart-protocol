# Copy to .env and fill in locally. Never commit a real .env file.
# Every value below is a placeholder. No real credentials ship in this repo.

# Meta Model API provider (providers/meta.ts). All three are read from the
# environment only. The exact model IDs available on an account are account
# specific, so the model ID is configuration, never a code constant.
META_MODEL_API_KEY=
META_MODEL_ID=
META_MODEL_API_BASE_URL=

# ClearCart Gate demo settings (services/gate).
# GATE_API_KEY, when set, is required as the x-gate-key header on /v1 routes.
# This is demo-grade auth for the reference implementation only.
GATE_API_KEY=demo-gate-key
# Demo HMAC secret used to stamp decision receipts. Demo value, not a
# production signing key.
GATE_DEMO_SECRET=demo-secret
